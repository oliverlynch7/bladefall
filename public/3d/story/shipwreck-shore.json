      ],
      "voice": {
        "speaker": "rose",
        "scene": "Shipwreck Shore",
        "order": 10,
        "emotion": "Quiet pride with grief under the surface",
        "direction": "Natural, clear speech. Leave a short beat around the joke or emotional turn.",
        "context": "On Shipwreck Shore, preparing a boat to reach the remote Sunspire Palace."
      }
    },
    "sc.rose.memory": {
      "text": "Storm drove us ashore. I stayed with the wheel. They took the small boat. I never saw where it landed. A captain is supposed to know where everyone is.",
      "choices": [
        {
          "id": "help",
          "text": "I will look for the bell and a record.",
          "next": "sc.rose.wait",
          "effects": [
            {
              "type": "flag",
