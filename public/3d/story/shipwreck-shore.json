    "sc.rose.truth": {
      "text": "Together. That is more than I knew yesterday. Thank you for telling it straight. Take this strange purple piece. Pulled it from our deck after the palace fell silent. It deserves a better journey than mine.",
      "choices": [
        {
          "id": "advice",
          "text": "Any advice for the crossing?",
          "next": "sc.rose.advice",
          "effects": [],
          "when": []
        }
      ],
      "voice": {
        "speaker": "rose",
        "scene": "Shipwreck Shore",
        "order": 13,
        "emotion": "Relief, restrained rather than cheerful",
        "direction": "Natural, clear speech. Leave a short beat around the joke or emotional turn.",
        "context": "On Shipwreck Shore, preparing a boat to reach the remote Sunspire Palace."
      }
    },
    "sc.rose.kind": {
      "text": "I have spent so long remembering who I could not see that I forgot who got away. Keep this purple piece. And keep your head when the sea starts shouting.",
      "choices": [
        {
          "id": "advice",
          "text": "What should I watch for?",
          "next": "sc.rose.advice",
          "effects": [],
          "when": []
        }
      ],
      "voice": {
        "speaker": "rose",
        "scene": "Shipwreck Shore",
        "order": 14,
        "emotion": "Warm, moved",
        "direction": "Natural, clear speech. Leave a short beat around the joke or emotional turn.",
        "context": "On Shipwreck Shore, preparing a boat to reach the remote Sunspire Palace."
      }
    },
    "sc.rose.advice": {
      "text": "Watch the water beside a rock, not the rock itself. That is where you need to go. And never argue with a wave. It has heard every good argument and sunk all of them.",
      "choices": [
        {
          "id": "thanks",
          "text": "I will remember that.",
          "next": "sc.rose.advice",
          "effects": [],
          "when": []
        }
