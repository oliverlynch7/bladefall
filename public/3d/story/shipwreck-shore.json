        "direction": "Natural, clear speech. Leave a short beat around the joke or emotional turn.",
        "context": "On Shipwreck Shore, preparing a boat to reach the remote Sunspire Palace."
      }
    },
    "sc.rose.hello": {
      "text": "That wreck was mine. Bell still hangs inside, I expect. I keep meaning to fetch it. Funny how a short walk can get longer every morning.",
      "choices": [
        {
          "id": "help",
          "text": "I can bring the bell back.",
          "next": "sc.rose.wait",
          "effects": [
            {
              "type": "flag",
              "id": "sc.rose.met",
              "value": true
            },
            {
              "type": "quest",
              "id": "sc.bell",
              "value": "active"
            },
            {
              "type": "note",
              "id": "sc.bell",
              "region": "storm",
              "title": "Rose's last voyage",
              "text": "Captain Rose wants the bell from his old wreck north-west of the work beach. There may be a record of what happened inside."
            }
          ],
          "when": []
        },
        {
          "id": "ask",
          "text": "What happened to your crew?",
          "next": "sc.rose.memory",
          "effects": [],
          "when": []
