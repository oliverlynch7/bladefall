/
  Cache-Control: no-store
/2d/
  Cache-Control: no-store
/2d/index.html
  Cache-Control: no-store
/3d/
  Cache-Control: no-store
/3d/index.html
  Cache-Control: no-store

# The 3D slice is iterated on constantly — never let a browser serve a stale build.
# (This was missing while /, /2d/ and /3d/ had it, so slice fixes appeared not to land.)
/slice3d/
  Cache-Control: no-store
/slice3d/index.html
  Cache-Control: no-store
/poc3d/
  Cache-Control: no-store
/poc3d/index.html
  Cache-Control: no-store

/3d/voice-studio/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; media-src 'self' blob:; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  Permissions-Policy: microphone=(self), camera=()
