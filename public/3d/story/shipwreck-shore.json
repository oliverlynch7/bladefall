    "sc.otto.rudder": {
      "text": "A little split, but straight. That will do. Now we can choose which rock we hit. Ideally, none.",
      "choices": [
        {
          "id": "more",
          "text": "About the other supplies...",
          "next": "sc.otto.work",
          "effects": [],
          "when": []
        }
      ],
      "voice": {
        "speaker": "otto",
        "scene": "Shipwreck Shore",
        "order": 4,
        "emotion": "Conversational",
        "direction": "Natural, clear speech. Leave a short beat around the joke or emotional turn.",
        "context": "On Shipwreck Shore, preparing a boat to reach the remote Sunspire Palace."
      }
    },
    "sc.otto.sail": {
      "text": "Good cloth. The Legion used it to cover their supplies. Apparently keeping stolen bread dry matters more than letting people leave.",
      "choices": [
        {
          "id": "more",
          "text": "About the other supplies...",
          "next": "sc.otto.work",
          "effects": [],
          "when": []
        }
