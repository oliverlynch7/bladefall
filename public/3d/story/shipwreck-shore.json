        "order": 6,
        "emotion": "Conversational",
        "direction": "Natural, clear speech. Leave a short beat around the joke or emotional turn.",
        "context": "On Shipwreck Shore, preparing a boat to reach the remote Sunspire Palace."
      }
    },
    "sc.otto.routes": {
      "text": "The tilted hull lies west of here. Its deck rises toward the broken stern. Sailcloth is on the east lookout. The storage cave is below that ridge; open its drain before lifting the inside latch.",
      "choices": [
        {
          "id": "back",
          "text": "I have what I need.",
          "next": "sc.otto.work",
          "effects": [],
          "when": []
        }
      ],
      "voice": {
        "speaker": "otto",
        "scene": "Shipwreck Shore",
        "order": 7,
        "emotion": "Conversational",
        "direction": "Natural, clear speech. Leave a short beat around the joke or emotional turn.",
        "context": "On Shipwreck Shore, preparing a boat to reach the remote Sunspire Palace."
      }
    },
    "sc.otto.ready": {
      "text": "She floats. That is the first test. Keep clear of the marked rocks. If anyone boards you, hold a safe course and clear the deck. There is sheltered water halfway across where you can patch the hull and trade the helm.",
      "choices": [
        {
          "id": "depart",
          "text": "I will board when I am ready.",
          "next": "sc.otto.farewell",
          "effects": [
            {
              "type": "note",
              "id": "sc.crossing",
              "region": "storm",
              "title": "Before setting sail",
              "text": "Board beside Otto when you are ready. Shore secrets cannot be collected during the voyage. Steer around rocks; fight boarders on the safe stretches. Repair once in sheltered water. Reach the far shore to keep this half's rewards."
            }
          ],
          "when": []
        }
      ],
      "voice": {
        "speaker": "otto",
        "scene": "Shipwreck Shore",
        "order": 8,
        "emotion": "Conversational",
        "direction": "Natural, clear speech. Leave a short beat around the joke or emotional turn.",
        "context": "On Shipwreck Shore, preparing a boat to reach the remote Sunspire Palace."
      }
    },
    "sc.otto.farewell": {
      "text": "Take a last look around before you leave. Boats are good at going places. Less good at popping back for something you forgot.",
      "choices": [
        {
          "id": "check",
          "text": "Let me check the shore.",
          "next": "sc.otto.farewell",
          "effects": [],
          "when": []
        }
