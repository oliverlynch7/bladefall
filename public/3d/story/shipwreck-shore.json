  "nodes": {
    "sc.otto.hello": {
      "text": "Martin sent you? Then the forge really has gone quiet. Good. I was getting tired of fixing boats for people who planned to steal them.",
      "choices": [
        {
          "id": "palace",
          "text": "I need to reach Sunspire.",
          "next": "sc.otto.plan",
          "effects": [
            {
              "type": "flag",
              "id": "sc.met",
              "value": true
            },
            {
              "type": "quest",
              "id": "sc.boat",
              "value": "active"
            },
            {
              "type": "note",
              "id": "sc.boat",
              "region": "storm",
              "title": "Something that floats",
              "text": "Otto can repair the boat. Find a rudder in the tilted wreck, sailcloth at the lookout, and rope in the storage cave. Bring back any supplies together."
            }
          ],
          "when": []
        }
      ],
      "voice": {
        "speaker": "otto",
        "scene": "Shipwreck Shore",
        "order": 1,
        "emotion": "Conversational",
        "direction": "Natural, clear speech. Leave a short beat around the joke or emotional turn.",
        "context": "On Shipwreck Shore, preparing a boat to reach the remote Sunspire Palace."
      }
    },
    "sc.otto.plan": {
      "text": "Sunspire is beyond the island cliffs. This boat can get you there. It needs a rudder, sailcloth and rope. The sea has been kind enough to scatter all three within walking distance. Its first helpful act in years.",
      "choices": [
        {
          "id": "work",
          "text": "I will find them.",
          "next": "sc.otto.work",
          "effects": [],
          "when": []
        }
      ],
      "voice": {
        "speaker": "otto",
        "scene": "Shipwreck Shore",
        "order": 2,
        "emotion": "Conversational",
        "direction": "Natural, clear speech. Leave a short beat around the joke or emotional turn.",
        "context": "On Shipwreck Shore, preparing a boat to reach the remote Sunspire Palace."
      }
    },
    "sc.otto.work": {
      "text": "What have you found? I can fit one piece while you look for the others. Or bring the whole lot. I charge the same either way: please come back alive.",
